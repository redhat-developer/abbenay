{
  "name": "abbenay-provider",
  "displayName": "Abbenay Provider",
  "description": "Use any LLM with any VS Code extension - OpenAI, Anthropic, Google, Ollama & more. The open alternative to Copilot.",
  "version": "0.0.0-dev",
  "publisher": "redhat",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "gemini",
    "ollama",
    "copilot",
    "language model",
    "chatgpt",
    "local llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/abbenay"
  },
  "homepage": "https://github.com/redhat-developer/abbenay#readme",
  "bugs": {
    "url": "https://github.com/redhat-developer/abbenay/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "abbenay.daemonStatus",
        "title": "Show Daemon Status",
        "category": "Abbenay"
      },
      {
        "command": "abbenay.openDashboard",
        "title": "Open Dashboard",
        "category": "Abbenay",
        "icon": "$(dashboard)"
      },
      {
        "command": "abbenay.configureProvider",
        "title": "Configure Providers",
        "category": "Abbenay",
        "icon": "$(gear)"
      },
      {
        "command": "abbenay.chat.send",
        "title": "Send Message to Chat",
        "category": "Abbenay"
      },
      {
        "command": "abbenay.setDaemonToken",
        "title": "Set Daemon Token",
        "category": "Abbenay"
      },
      {
        "command": "abbenay.clearDaemonToken",
        "title": "Clear Daemon Token",
        "category": "Abbenay"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "abbenay",
          "title": "Abbenay",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "abbenay": [
        {
          "type": "webview",
          "id": "abbenay.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Abbenay Provider",
      "properties": {
        "abbenay.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for the extension"
        },
        "abbenay.daemonAddress": {
          "type": "string",
          "default": "",
          "description": "Remote Abbenay gRPC address (host:port), e.g. 127.0.0.1:50051. When set, the extension connects to this daemon and does not auto-start a local process. Leave empty for local IPC (Unix socket / daemon.addr)."
        },
        "abbenay.daemonTls": {
          "type": "boolean",
          "default": true,
          "description": "Use TLS when connecting to abbenay.daemonAddress. Defaults to true (matches container --grpc-tls). Ignored for local Unix-socket connections."
        },
        "abbenay.daemonCaPath": {
          "type": "string",
          "default": "",
          "description": "Path to the daemon CA PEM file (e.g. container runtime tls/ca.crt). Required for self-signed / auto-generated certs."
        },
        "abbenay.daemonSslTargetName": {
          "type": "string",
          "default": "abbenay-grpc",
          "description": "SSL target name override for auto-generated daemon certificates (default: abbenay-grpc)."
        },
        "abbenay.daemonTokenEnv": {
          "type": "string",
          "default": "",
          "description": "Environment variable name whose value is sent as x-abbenay-token consumer auth metadata. Prefer Abbenay: Set Daemon Token (SecretStorage) when possible."
        },
        "abbenay.lmToolMode": {
          "type": "string",
          "enum": [
            "passthrough",
            "auto"
          ],
          "default": "passthrough",
          "description": "How Abbenay handles tools when another extension (e.g. GitHub Copilot) sends tools with a chat request. passthrough: return tool calls to the host for native VS Code execution (recommended for Copilot). auto: Abbenay runs the tool loop and invokes tools via the backchannel (legacy)."
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "abbenay",
        "displayName": "Abbenay"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "build": "npm run bundle",
    "bundle": "node esbuild.js --production",
    "bundle:daemon": "node scripts/bundle-daemon.js",
    "compile": "tsc -p ./",
    "compile:check": "tsc -p ./ --noEmit",
    "clean": "rm -rf out bin",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "npm run bundle && vsce package --no-dependencies",
    "package:all-platforms": "npm run bundle && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "globals": "^16",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.1",
    "@vscode-elements/elements": "^2.5.1",
    "highlight.js": "^11.11.1",
    "long": "^5.3.2",
    "marked": "^18.0.4",
    "nice-grpc": "^2.1.14",
    "nice-grpc-common": "^2.0.2"
  }
}
